{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIM Bank SMS Reader",
  "version": "1.3.1",
  "identifier": "com.smsreader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIM Bank SMS Reader",
        "width": 1300,
        "height": 720,
        "minWidth": 980,
        "minHeight": 520,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "backgroundColor": "#171717"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQjlFQjNGMjYwNkE5NEMKUldSTXFRWW1QK3U1cnpBZnpVU2ZiTWdSVkY5YU9nWWZja2FpU1RGZXF4VU8wa2czYTV5MThZYTkK",
      "endpoints": [
        "https://github.com/RyanWez/sms-deliverer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}